# LLM Provider Configuration
# Supported providers: openai, gemini, groq, openrouter, ollama, mock
# Leave empty or set to 'mock' to use the mock provider (no API key required)

NEXT_PUBLIC_LLM_PROVIDER=mock
NEXT_PUBLIC_LLM_MODEL=gpt-3.5-turbo

# OpenAI Configuration
# NEXT_PUBLIC_OPENAI_API_KEY=sk-...

# Google Gemini Configuration
# NEXT_PUBLIC_GEMINI_API_KEY=...
# NEXT_PUBLIC_LLM_MODEL=gemini-pro

# Groq Configuration
# NEXT_PUBLIC_GROQ_API_KEY=...
# NEXT_PUBLIC_LLM_MODEL=mixtral-8x7b-32768

# OpenRouter Configuration
# NEXT_PUBLIC_OPENROUTER_API_KEY=sk-or-...
# NEXT_PUBLIC_LLM_MODEL=openai/gpt-3.5-turbo

# Ollama Configuration
# NEXT_PUBLIC_OLLAMA_BASE_URL=http://localhost:11434
# NEXT_PUBLIC_LLM_MODEL=llama2
